{
  "$schema": "https://json.schemastore.org/package",
  "name": "@peridoc/stripe-guard",
  "version": "0.1.4",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Peridoc",
    "email": "dev@peridoc.org",
    "url": "https://peridoc.org"
  },
  "description": "Stripe Guard is a code generation utility that uses Stripe's existing types to enforce pre-request validation for Stripe API calls.",
  "keywords": [
    "stripe",
    "validation",
    "code generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peridocorg/stripe-guard.git"
  },
  "type": "module",
  "bin": {
    "stripe-guard": "dist/index.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "pretest": "pnpm run build",
    "bench": "vitest bench",
    "build": "tsdown",
    "prebuild": "pnpm run clean:cache && pnpm run typecheck && pnpm run format && pnpm run lint:fix",
    "prepublishOnly": "pnpm test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "lint": "eslint -c eslint.config.mjs src/",
    "lint:fix": "pnpm run lint --fix",
    "clean": "pnpm run clean:cache dist node_modules",
    "clean:cache": "rimraf .cache"
  },
  "dependencies": {
    "expect-type": "^1.4.0",
    "ts-patch": "^3.0.0",
    "ts-runtime-checks": "^0.6.0",
    "type-fest": "^4.0.0"
  },
  "peerDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@types/node": ">=16.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-sourcemaps": "^0.6.0",
    "stripe": "^18.0.0",
    "typescript": "^5.0.0",
    "terser": "^5.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/runner": "^3.2.7",
    "@vitest/snapshot": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/eslint-config-prettier": "6.11.3",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@tsconfig/node22": "22.0.6",
    "@types/wait-on": "^5.3.4",
    "eslint": "^9.39.5",
    "eslint_d": "^14.3.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.11",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^59.0.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "typescript-eslint": "^8.72.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "vite": "^7.3.8",
    "vite-plugin-inspect": "^11.4.1",
    "vite-tsconfig-paths": "^5.1.3",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.5"
  },
  "prettier": "./prettier.config.mjs"
}
